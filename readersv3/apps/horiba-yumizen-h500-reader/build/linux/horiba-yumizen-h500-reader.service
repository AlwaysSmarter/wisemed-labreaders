[Unit]
Description=WiseMED readersv3 HORIBA Yumizen H500 Reader background service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/horiba-yumizen-h500-reader
ExecStart=/opt/horiba-yumizen-h500-reader/horiba-yumizen-h500-reader -config deployments/config.yaml -headless
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

[Unit]
Description=WiseMED readersv3 BioMerieux miniVIDAS Reader background service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/biomerieux-minividas-reader
ExecStart=/opt/biomerieux-minividas-reader/biomerieux-minividas-reader -config deployments/config.yaml -headless
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

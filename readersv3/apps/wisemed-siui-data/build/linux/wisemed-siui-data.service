[Unit]
Description=WiseMED readersv3 WiseMED SIUI Data background service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/wisemed-siui-data
ExecStart=/opt/wisemed-siui-data/wisemed-siui-data -config deployments/config.yaml -headless
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

[Unit]
Description=WiseMED readersv3 Anaf Docsmart background service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/anaf-docsmart
ExecStart=/opt/anaf-docsmart/anaf-docsmart -config deployments/config.yaml -headless
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

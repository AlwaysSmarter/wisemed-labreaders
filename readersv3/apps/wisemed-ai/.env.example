# Docker: copy to docker/.env, use `openssl rand -hex 24` for the password.
POSTGRES_PASSWORD=replace_with_random_hex_secret
WISEMED_AI_BIND=127.0.0.1
WISEMED_AI_PORT=19120
OPENAI_API_KEY=
# Native: pass a properly URL-encoded PostgreSQL DSN via the environment.
# WISEMED_AI_DATABASE_URL=postgres://user:password@127.0.0.1:5432/database?sslmode=verify-full

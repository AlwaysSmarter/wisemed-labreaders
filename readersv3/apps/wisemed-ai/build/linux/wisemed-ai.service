[Unit]
Description=WiseMED readersv3 AI background service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wisemed-ai
Environment=HOME=/opt/wisemed-ai
WorkingDirectory=/opt/wisemed-ai
ExecStart=/opt/wisemed-ai/wisemed-ai -config deployments/config.yaml
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

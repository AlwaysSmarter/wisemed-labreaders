[Unit]
Description=WiseMED readersv3 Autobio AutoLumo S900 Reader background service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/autobio-autolumo-s900-reader
ExecStart=/opt/autobio-autolumo-s900-reader/autobio-autolumo-s900-reader -config deployments/config.yaml -headless
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

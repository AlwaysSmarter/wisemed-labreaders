{
  "html": "<!DOCTYPE html>\n<html lang=\"ro\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>WiseMED — exemplu HTML Print Formatter</title>\n  <script src=\"jquery-3.7.1.min.js\"></script>\n  <style>\n    body { font: 16px Arial, sans-serif; margin: 32px; }\n    #report { width: 800px; border: 1px solid #075985; padding: 20px; }\n    section { padding: 16px; }\n  </style>\n</head>\n<body>\n  <h1>Raport WiseMED</h1>\n  <main id=\"report\"><section id=\"destination\"><h2>Rezultate</h2></section></main>\n  <section id=\"source\"><p class=\"result\">Hemoglobină: 14 g/dL</p></section>\n  <script>\n    function compact_sections() { $('section').css('padding', '8px'); }\n    function normalize_content() { $('.result').css('line-height', '20px'); }\n    function move_content() { $('#source .result').appendTo('#destination'); $('#source').remove(); }\n    $(document).ready(async function () {\n      try {\n        // Raportul trebuie să aștepte resursele ÎNAINTE de măsurători/paginare.\n        if (document.fonts) await document.fonts.ready;\n        await Promise.all(Array.from(document.images, image => image.complete ? Promise.resolve() : new Promise(resolve => {\n          image.addEventListener('load', resolve, { once: true });\n          image.addEventListener('error', resolve, { once: true });\n        })));\n        compact_sections();\n        normalize_content();\n        move_content();\n        $('#report').attr('data-measured-width', $('#report').outerWidth());\n        $('<p class=\"generated\">DOM procesat de jQuery.</p>').appendTo('#report');\n        console.log('WiseMED: procesarea raportului s-a terminat');\n        window.printReady = true;\n      } catch (error) {\n        window.printError = error.message || String(error);\n      }\n    });\n  </script>\n</body>\n</html>\n",
  "base_url": "http://127.0.0.1:19113/help/",
  "timeout_ms": 120000,
  "viewport_width": 1280,
  "viewport_height": 900
}

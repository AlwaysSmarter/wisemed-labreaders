[Unit]
Description=WiseMED readersv3 SIUI Bridge History background service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/siui-bridge-history
ExecStart=/opt/siui-bridge-history/siui-bridge-history -config deployments/config.yaml -headless
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

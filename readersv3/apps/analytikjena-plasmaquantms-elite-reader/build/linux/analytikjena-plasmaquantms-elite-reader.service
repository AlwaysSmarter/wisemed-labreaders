[Unit]
Description=WiseMED readersv3 Analytikjena Plasmaquantms Elite Reader background service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/analytikjena-plasmaquantms-elite-reader
ExecStart=/opt/analytikjena-plasmaquantms-elite-reader/analytikjena-plasmaquantms-elite-reader -config deployments/config.yaml -headless
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

[Unit]
Description=WiseMED readersv3 Lifotronic H8 Reader background service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/lifotronic-h8-reader
ExecStart=/opt/lifotronic-h8-reader/lifotronic-h8-reader -config deployments/config.yaml -headless
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

[Unit]
Description=WiseMED readersv3 Cfx96 Reader background service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/cfx96-reader
ExecStart=/opt/cfx96-reader/cfx96-reader -config deployments/config.yaml -headless
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

[Unit]
Description=WiseMED readersv3 HORIBA ABX Pentra 400 Reader background service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/horiba-abx-pentra400-reader
ExecStart=/opt/horiba-abx-pentra400-reader/horiba-abx-pentra400-reader -config deployments/config.yaml -headless
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

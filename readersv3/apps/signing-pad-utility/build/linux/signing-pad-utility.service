[Unit]
Description=WiseMED readersv3 Signing Pad Utility background service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/signing-pad-utility
ExecStart=/opt/signing-pad-utility/signing-pad-utility -config deployments/config.yaml -headless
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

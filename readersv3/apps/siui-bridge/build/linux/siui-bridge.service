[Unit]
Description=WiseMED readersv3 SIUI Bridge background service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/siui-bridge
ExecStart=/opt/siui-bridge/siui-bridge -config deployments/config.yaml -headless
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

<?xml version="1.0" encoding="utf-8"?>
<xs:schema targetNamespace="http://www.cnas.ro/pias/2.0" xmlns="http://www.cnas.ro/pias/2.0" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" id="DocumentSeriesResponse">
	<xs:annotation>
		<xs:documentation xml:lang="ro">Structura unui răspuns pentru seriile de documente medicale electronice</xs:documentation>
	</xs:annotation>
	<xs:include schemaLocation="CommonDocumentTypesPias.xsd"/>
	<xs:complexType name="documentSeriesResponse" abstract="true">
		<xs:annotation>
			<xs:documentation xml:lang="ro">Tipul de date de bază folosit pentru transmiterea cererilor de validare (elemente comune)</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="responseBaseType">
				<xs:sequence>
					<xs:element name="documentSeriesList"  minOccurs="0">
						<xs:annotation>
							<xs:documentation xml:lang="ro">Lista de serii pentru documente medicale</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:sequence>
								<xs:element name="documentSeriesItem" minOccurs="0" maxOccurs="unbounded">
									<xs:annotation>
										<xs:documentation xml:lang="ro">Definiţia unei serii pentru documente medicale</xs:documentation>
									</xs:annotation>
									<xs:complexType>
										<xs:attribute name="documentType" type="documentType" use="required">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Tipul de document medical</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="series" use="required">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Serie document</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="20"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="firstNo" type="xs:integer" use="required">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Primul număr</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="lastNo" type="xs:integer" use="required">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Ultimul număr</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="validFrom" type="xs:date" use="required">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Data de inceput a valabilităţii</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="validTo" type="xs:date" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Data de sfârşit a valabilităţii</xs:documentation>
											</xs:annotation>
										</xs:attribute>
									</xs:complexType>
								</xs:element>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:element name="GetDocumentSeriesResponse">
		<xs:annotation>
			<xs:documentation xml:lang="ro">Răspuns pentru importul seriilor de documente medicale</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="documentSeriesResponse"/>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="GenDocumentSeriesResponse">
		<xs:annotation>
			<xs:documentation xml:lang="ro">Răspuns pentru generarea seriilor de documente medicale</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="documentSeriesResponse"/>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
</xs:schema>

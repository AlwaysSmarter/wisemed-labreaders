<?xml version="1.0" encoding="utf-8"?>
<xs:schema targetNamespace="http://www.cnas.ro/pias/2.0" xmlns="http://www.cnas.ro/pias/2.0" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" id="HomeCareMedicalPlanRequest">
	<xs:annotation>
		<xs:documentation xml:lang="ro">Structura unei cereri de validare pentru plan de tratament pentru îngrijire la domiciliu (documente medicale electronice)</xs:documentation>
	</xs:annotation>
	<xs:include schemaLocation="CommonDocumentTypesPias.xsd"/>
	<xs:element name="HomeCareMedicalPlanRequest">
		<xs:annotation>
			<xs:documentation xml:lang="ro">Cerere de validare pentru plan de tratament pentru îngrijire la domiciliu</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="requestContractType">
					<xs:sequence>
						<xs:element name="homeCareMedicalPlan">
							<xs:annotation>
								<xs:documentation xml:lang="ro">Plan de tratament pentru îngrijire la domiciliu</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:complexContent>
									<xs:extension base="documentBaseType">
										<xs:sequence>
											<xs:element name="palliative" minOccurs="0" maxOccurs="unbounded">
												<xs:annotation>
													<xs:documentation xml:lang="ro">Serviciu medical de îngrijire la domiciliu recomandat</xs:documentation>
												</xs:annotation>
												<xs:complexType>
													<xs:attribute name="evaluationType" use="required">
														<xs:annotation>
															<xs:documentation xml:lang="ro">Tipul evaluării</xs:documentation>
														</xs:annotation>
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:enumeration value="I">
																	<xs:annotation>
																		<xs:documentation xml:lang="ro">Iniţială</xs:documentation>
																	</xs:annotation>
																</xs:enumeration>
																<xs:enumeration value="R">
																	<xs:annotation>
																		<xs:documentation xml:lang="ro">Reevaluare</xs:documentation>
																	</xs:annotation>
																</xs:enumeration>
															</xs:restriction>
														</xs:simpleType>
													</xs:attribute>
													<xs:attribute name="evaluationDate" type="xs:date" use="required">
														<xs:annotation>
															<xs:documentation xml:lang="ro">Data evaluării</xs:documentation>
														</xs:annotation>
													</xs:attribute>
													<xs:attribute name="evaluatorName" use="required">
														<xs:annotation>
															<xs:documentation xml:lang="ro">Numele complet al evaluatorului</xs:documentation>
														</xs:annotation>
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="100"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:attribute>
													<xs:attribute name="evaluatorSteancil" type="stencilType" use="required">
														<xs:annotation>
															<xs:documentation xml:lang="ro">Parafa evaluatorului</xs:documentation>
														</xs:annotation>
													</xs:attribute>
													<xs:attribute name="evaluatedProblem" use="required">
														<xs:annotation>
															<xs:documentation xml:lang="ro">Problema evaluată (actuală/potenţială)</xs:documentation>
														</xs:annotation>
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="100"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:attribute>
													<xs:attribute name="serviceCode" use="required">
														<xs:annotation>
															<xs:documentation xml:lang="ro">Serviciu paliativ stabilit de evaluator (cod din nomenclator)</xs:documentation>
														</xs:annotation>
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="20"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:attribute>
													<xs:attribute name="serviceDate" type="xs:date" use="optional">
														<xs:annotation>
															<xs:documentation xml:lang="ro">Data efectuării serviciului</xs:documentation>
														</xs:annotation>
													</xs:attribute>
													<xs:attribute name="nextServiceDate" type="xs:date" use="optional">
														<xs:annotation>
															<xs:documentation xml:lang="ro">Data următorului serviciu</xs:documentation>
														</xs:annotation>
													</xs:attribute>
													<xs:attribute name="caretakerName" use="optional">
														<xs:annotation>
															<xs:documentation xml:lang="ro">Numele complet al persoanei care a efectuat serviciile</xs:documentation>
														</xs:annotation>
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="100"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:attribute>
													<xs:attribute name="reevaluationDate" type="xs:date" use="optional">
														<xs:annotation>
															<xs:documentation xml:lang="ro">Data programată pentru reevaluare</xs:documentation>
														</xs:annotation>
													</xs:attribute>
												</xs:complexType>
											</xs:element>
										</xs:sequence>
										<xs:attribute name="decisionNo" use="required">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Numărul deciziei CAS</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="20"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="decisionDate" type="xs:date" use="required">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Data deciziei CAS</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="recommendCode" use="required">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Codul recomandării</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="20"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="recommendNo" use="required">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Numărul deciziei CAS</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="20"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="recommendDate" type="xs:date" use="required">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Data deciziei CAS</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="diagnostic" type="diagnosticCodeList" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Diagnosticul medical (lista codurilor de diagnostic)</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="diagnosticType" type="diagnosticType" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Tipul de diagnostic medical</xs:documentation>
											</xs:annotation>
										</xs:attribute>
									</xs:extension>
								</xs:complexContent>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
</xs:schema>

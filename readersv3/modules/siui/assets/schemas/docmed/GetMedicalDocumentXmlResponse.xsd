<?xml version="1.0" encoding="utf-8"?>
<xs:schema targetNamespace="http://www.cnas.ro/pias/2.0" xmlns="http://www.cnas.ro/pias/2.0" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" id="GetMedicalDocumentXmlResponse">
	<xs:annotation>
		<xs:documentation xml:lang="ro">Structura unui răspuns de obținere a unui document medical electronic în format XML</xs:documentation>
	</xs:annotation>
	<xs:include schemaLocation="CommonDocumentTypesPias.xsd"/>
	<xs:element name="GetMedicalDocumentXmlResponse">
		<xs:annotation>
			<xs:documentation xml:lang="ro">Răspuns de obținere a unui document medical electronic în format XML</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="responseBaseType">
					<xs:sequence>
						<xs:element name="document" minOccurs="0">
							<xs:annotation>
								<xs:documentation xml:lang="ro">Documentul medical în format XML (structura originală SIUI)</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:any namespace="##any" processContents="lax"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
					<xs:attribute name="documentType" type="documentType" use="optional">
						<xs:annotation>
							<xs:documentation xml:lang="ro">Tipul documentului medical (ML, SL, CR, LR, etc.)</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
</xs:schema>
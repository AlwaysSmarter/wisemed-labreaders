<?xml version="1.0" encoding="utf-8"?>
<xs:schema targetNamespace="http://www.cnas.ro/pias/2.0" xmlns="http://www.cnas.ro/pias/2.0" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" id="LaboratoryAGReferralRequest">
	<xs:annotation>
		<xs:documentation xml:lang="ro">Structura unei cereri de validare pentru bilet de trimitere pentru investigaţii de laborator - Angiografie (documente medicale electronice)</xs:documentation>
	</xs:annotation>
	<xs:include schemaLocation="CommonDocumentTypesPias.xsd"/>
	<xs:element name="LaboratoryAGReferralRequest">
		<xs:annotation>
			<xs:documentation xml:lang="ro">Cerere de validare pentru bilet de trimitere pentru investigaţii de laborator - Angiografie</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="requestContractType">
					<xs:sequence>
						<xs:element name="laboratoryAGReferral">
							<xs:annotation>
								<xs:documentation xml:lang="ro">Bilet de trimitere pentru investigaţii de laborator - Angiografie</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:complexContent>
									<xs:extension base="documentStencilType">
										<xs:sequence>
											<xs:element name="foreignPerson" type="foreignPersonType" minOccurs="0">
												<xs:annotation>
													<xs:documentation xml:lang="ro">Datele de identificare ale pacientului de altă cetăţenie</xs:documentation>
												</xs:annotation>
											</xs:element>
											<xs:element name="investigation" minOccurs="1" maxOccurs="unbounded">
												<xs:annotation>
													<xs:documentation xml:lang="ro">Detalii investigaţie</xs:documentation>
												</xs:annotation>
												<xs:complexType>
													<xs:attribute name="no" type="xs:integer" use="required">
														<xs:annotation>
															<xs:documentation xml:lang="ro">Numar curent</xs:documentation>
														</xs:annotation>
													</xs:attribute>
													<xs:attribute name="code" use="required">
														<xs:annotation>
															<xs:documentation xml:lang="ro">Codul investigaţiei (valoare din nomenclator)</xs:documentation>
														</xs:annotation>
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="20"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:attribute>
													<xs:attribute name="done" type="xs:boolean" use="optional">
														<xs:annotation>
															<xs:documentation xml:lang="ro">Investigaţie efectuată</xs:documentation>
														</xs:annotation>
													</xs:attribute>
												</xs:complexType>
											</xs:element>
										</xs:sequence>
										<xs:attribute name="referralType" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Tipul biletului de trimitere</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:integer">
													<xs:enumeration value="4">
														<xs:annotation>
															<xs:documentation xml:lang="ro">INVESTIGATII CT</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="sourceReferral" use="required">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Sursa bilet trimitere</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:integer">
													<xs:enumeration value="1">
														<xs:annotation>
															<xs:documentation xml:lang="ro">MF</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="2">
														<xs:annotation>
															<xs:documentation xml:lang="ro">Amb. Spec.</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="4">
														<xs:annotation>
															<xs:documentation xml:lang="ro">Altele</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="priorityLevel" use="required">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Nivel de prioritate</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:integer">
													<xs:enumeration value="1">
														<xs:annotation>
															<xs:documentation xml:lang="ro">Urgenta</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="2">
														<xs:annotation>
															<xs:documentation xml:lang="ro">Curente</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="citizenship" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Codul cetateniei pacientului (valoare din nomenclatorul Citizenships)</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="20"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="personState" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Starea de asigurare al pacientului (valoare din nomenclatorul PersonStates)</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="20"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="nhpNumber" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Numar PNS (Program Naţional de Sănătate)</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="5"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="diagnostic" type="diagnosticCodeList" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Diagnosticul medical/prezumptiv (lista codurilor de diagnostic)</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="labDiseaseType" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Pachetul de servicii de care beneficiaza pacientul</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:integer">
													<xs:enumeration value="1">
														<xs:annotation>
															<xs:documentation xml:lang="ro">P</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="2">
														<xs:annotation>
															<xs:documentation xml:lang="ro">A/S</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="3">
														<xs:annotation>
															<xs:documentation xml:lang="ro">C</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="6">
														<xs:annotation>
															<xs:documentation xml:lang="ro">SO</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="7">
														<xs:annotation>
															<xs:documentation xml:lang="ro">AO</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="workEvent" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Accidente de muncă / Boli profesionale / Daune</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:integer">
													<xs:enumeration value="1">
														<xs:annotation>
															<xs:documentation xml:lang="ro">Accident de munca</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="2">
														<xs:annotation>
															<xs:documentation xml:lang="ro">Boli profeisonale</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="3">
														<xs:annotation>
															<xs:documentation xml:lang="ro">Daune</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="presentationDate" type="xs:date" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Data prezentarii cu biletul de trimitere la laborator</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="employeeProvName" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Numele şi semnătura persoanei desemnate de furnizorul de servicii paraclinice</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="100"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="reconfDate" type="xs:date" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Dată reconfirmare</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="reconfStencilNo" type="stencilType" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Farafă reconfirmare</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="agExAnte" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Examen angiografic anterior</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:integer">
													<xs:enumeration value="1">
														<xs:annotation>
															<xs:documentation xml:lang="ro">DA</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="2">
														<xs:annotation>
															<xs:documentation xml:lang="ro">NU</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="personWeight" type="xs:integer" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Greutate pacient (kg)</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="allergicHistory" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Antecedente alergice</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:integer">
													<xs:enumeration value="1">
														<xs:annotation>
															<xs:documentation xml:lang="ro">DA</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="2">
														<xs:annotation>
															<xs:documentation xml:lang="ro">NU</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="rightFAPulse" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Puls arteră femurală dreaptă</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="10"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="leftFAPulse" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Puls arteră femurală stângă</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="100"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="diabeticPatient" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Pacient diabetic</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:integer">
													<xs:enumeration value="1">
														<xs:annotation>
															<xs:documentation xml:lang="ro">DA</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="2">
														<xs:annotation>
															<xs:documentation xml:lang="ro">NU</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="underTreatHypoSulf" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">în tratament cu sulfamide hipoglicemiante</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:integer">
													<xs:enumeration value="1">
														<xs:annotation>
															<xs:documentation xml:lang="ro">DA</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="2">
														<xs:annotation>
															<xs:documentation xml:lang="ro">NU</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="hepatitis" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Hepatita</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:integer">
													<xs:enumeration value="1">
														<xs:annotation>
															<xs:documentation xml:lang="ro">DA</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="2">
														<xs:annotation>
															<xs:documentation xml:lang="ro">NU</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
									</xs:extension>
								</xs:complexContent>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
</xs:schema>

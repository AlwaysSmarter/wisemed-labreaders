<?xml version="1.0" encoding="utf-8"?>
<xs:schema targetNamespace="http://www.cnas.ro/pias/2.0" xmlns="http://www.cnas.ro/pias/2.0" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" id="MedicalLeaveRequest">
	<xs:annotation>
		<xs:documentation xml:lang="ro">Structura unei cereri de validare pentru certificat de concediu medical (documente medicale electronice)</xs:documentation>
	</xs:annotation>
	<xs:include schemaLocation="CommonDocumentTypesPias.xsd"/>
	<xs:element name="MedicalLeaveRequest">
		<xs:annotation>
			<xs:documentation xml:lang="ro">Cerere de validare pentru certificat de concediu medical</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="requestConventionType">
					<xs:sequence>
						<xs:element name="physicianCertificate">
							<xs:annotation>
								<xs:documentation xml:lang="ro">Certificat de concediu medical eliberat de medic</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:complexContent>
									<xs:extension base="documentStencilType">
										<xs:attribute name="emergency" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Tipul urgenţei medico-chirurgicală</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="3"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="contagious" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Tipul bolii infecto-contagioase (izolare)</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="2"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="isEmergencyRecommendation" type="xs:boolean" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Are recomandare de urgenţă medico-chirurgicală?</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="emContDate" type="xs:date" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Data recomandării de urgenţă</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="emContStencilNo" type="stencilType" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Numărul parafei care a recomandat urgenţa</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="initial" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Este certificat iniţial?</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:integer">
													<xs:enumeration value="1">
														<xs:annotation>
															<xs:documentation xml:lang="ro">iniţial</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="2">
														<xs:annotation>
															<xs:documentation xml:lang="ro">în continuare</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="initialSerialCode" use="required">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Seria documentului medical iniţial (dacă este continuare)</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="5"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="initialSerialNo" use="required">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Numărul documentului medical iniţial (dacă este continuare)</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="10"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="duplicate" type="xs:integer" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Specifică numărul de duplicat al certificatul medical (de câte ori a fost duplicat)</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="duplSerialCode" use="optional" >
											<xs:annotation>
												<xs:documentation xml:lang="ro">Seria documentului medical iniţial (dacă este continuare)</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="7"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="duplSerialNo" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Numărul documentului medical iniţial (dacă este continuare)</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="10"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="month" type="monthType" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Numărul parafei care a recomandat urgenţa</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="year" type="yearType" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Numărul parafei care a recomandat urgenţa</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="indemnCode" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Codul de indemnizaţie al certificatului medical</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="2"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="childCid" type="cidType" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Codul de identificare al copilului/ PNCC</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="certType" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Tipul certificatului medical</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:enumeration value="AM">
														<xs:annotation>
															<xs:documentation xml:lang="ro">Ambulator</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="IN">
														<xs:annotation>
															<xs:documentation xml:lang="ro">Internare</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="EX">
														<xs:annotation>
															<xs:documentation xml:lang="ro">Externare</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="department" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Pentru internare, numele sectiei</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="20"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="daysNo" type="xs:string" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Nunărul de zile</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="internValidFrom" type="xs:date" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Data de început a perioadei de concediu medical internat</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="internValidTo" type="xs:date" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Data de sfârşit a perioadei de concediu medical internat</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="internDiagCode" type="diagnosticCodeList" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Diagnosticul medical pentru internare (lista codurilor de diagnostic)</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="internDiagType" type="diagnosticType" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Tipul de diagnostic medical</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="externValidFrom" type="xs:date" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Data de început a perioadei de concediu medical ambulatoriu</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="externValidTo" type="xs:date" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Data de sfârşit a perioadei de concediu medical ambulatoriu</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="externDiagCode" type="diagnosticCodeList" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Diagnosticul medical pentru ambulatoriu (lista codurilor de diagnostic)</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="externDiagType" type="diagnosticType" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Tipul de diagnostic medical</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="externCheifStencil" type="stencilType" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Cod parafă (medic şef de secţie la externare)</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="issuerInsuranceHouse" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Casa de asigurări emitentă (medic care lucrează la CAS judeţeană) </xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="20"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="insHouseDirector" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Director general CAS judeţeană (certificat emis la CAS)</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="50"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="insHouseChiefStencil" type="stencilType" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Parafă medic şef CAS judeţenă (certificat emis la CAS)</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="expertNo" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Numărul avizului medicului expert/specialist (când acesta este necesar)</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="6"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="expertDate" type="xs:date" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Data avizului medicului expert/specialist</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="expertStencil" type="stencilType" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Parafa medicului expert/specialist care avizează</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="maternStencil" type="stencilType" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Parafa medic risc maternal (dacă e cazul)</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="receivedDate" type="xs:date" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Data primirii de către pacient/beneficiar</xs:documentation>
											</xs:annotation>
										</xs:attribute>
									</xs:extension>
								</xs:complexContent>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
</xs:schema>

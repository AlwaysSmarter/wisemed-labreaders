<?xml version="1.0" encoding="utf-8"?>
<xs:schema targetNamespace="http://www.cnas.ro/pias/2.0" xmlns="http://www.cnas.ro/pias/2.0" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" id="MedicalDeviceRecommendationRequest">
	<xs:annotation>
		<xs:documentation xml:lang="ro">Structura unei cereri de validare pentru recomandare pentru dispozitive medicale (documente medicale electronice)</xs:documentation>
	</xs:annotation>
	<xs:include schemaLocation="CommonDocumentTypesPias.xsd"/>
	<xs:element name="MedicalDeviceRecommendationRequest">
		<xs:annotation>
			<xs:documentation xml:lang="ro">Cerere de validare pentru recomandare pentru dispozitive medicale</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="requestContractType">
					<xs:sequence>
						<xs:element name="medicalDeviceRecommendation">
							<xs:annotation>
								<xs:documentation xml:lang="ro">Recomandare pentru dispozitive medicale</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:complexContent>
									<xs:extension base="documentStencilType">
										<xs:sequence>
											<xs:element name="foreignPerson" type="foreignPersonType" minOccurs="0">
												<xs:annotation>
													<xs:documentation xml:lang="ro">Datele de identificare ale pacientului de altă cetăţenie</xs:documentation>
												</xs:annotation>
											</xs:element>
										</xs:sequence>
										<xs:attribute name="source" use="required">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Sursa recomandare</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:integer">
													<xs:enumeration value="1">
														<xs:annotation>
															<xs:documentation xml:lang="ro">MF</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="2">
														<xs:annotation>
															<xs:documentation xml:lang="ro">Ambulatoriu</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="3">
														<xs:annotation>
															<xs:documentation xml:lang="ro">Spital</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="physMedLetContractNo" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Numărul de contract al medicului emitent al scrisorii medicale</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="10"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="physMedLetInsuranceHouse" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Codul casei de asigurări cu care are contract medicul emitent al scrisorii medicale</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="20"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="physicianSpecialty" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Specialitatea medicului prescriptor/emitent </xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="20"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="physicianPhoneNo" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Numărul de telefon al medicului prescriptor/emitent </xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="15"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="physicianEmail" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Adresa de email medicului prescriptor/emitent </xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="100"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="pnccPatient" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Pacient diagnosticat cu afecțiune oncologică?</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:integer">
													<xs:enumeration value="1">
														<xs:annotation>
															<xs:documentation xml:lang="ro">DA</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="2">
														<xs:annotation>
															<xs:documentation xml:lang="ro">NU</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="diagnostic" type="diagnosticCodeList" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Diagnosticul medical (lista codurilor de diagnostic)</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="diagnosticType" type="diagnosticType" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Tipul de diagnostic medical</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="deficiency" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Deficienţa organică sau funcţională?</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:integer">
													<xs:enumeration value="1">
														<xs:annotation>
															<xs:documentation xml:lang="ro">nu este ca urmare a unei boli profesionale</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="2">
														<xs:annotation>
															<xs:documentation xml:lang="ro">nu este ca urmare a unui accident de muncă ori sportiv</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="stomaUrinaryIncontinence" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Opţiuni pentru stomii pentru retenţie sau/şi incontinenţă urinară</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:integer">
													<xs:enumeration value="1">
														<xs:annotation>
															<xs:documentation xml:lang="ro">permanentă</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="2">
														<xs:annotation>
															<xs:documentation xml:lang="ro">temporară</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="3">
														<xs:annotation>
															<xs:documentation xml:lang="ro">set modificat</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="stomaUrinaryIncontinenceDays" type="xs:integer" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Număr de zile recomandate pentru stomii</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="cpap" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Opţiuni pentru oxigenoterapie, CPAP/BPAP și dispozitive de asistare a tusei</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:integer">
													<xs:enumeration value="1">
														<xs:annotation>
															<xs:documentation xml:lang="ro">cu certificat de încadrare în grad de handicap grav sau accentuat, definitiv</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="2">
														<xs:annotation>
															<xs:documentation xml:lang="ro">cu certificat de încadrare în grad de handicap grav sau accentuat</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="3">
														<xs:annotation>
															<xs:documentation xml:lang="ro">fara certificat de încadrare în grad de handicap grav sau accentuat</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="cpapDays" type="xs:integer" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Număr de zile recomandate pentru echipamente de oxigenoterapie, CPAP/BPAP și dispozitive de asistare a tusei</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="wheelchair" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Opţiuni pentru fotolii rulante</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:integer">
													<xs:enumeration value="1">
														<xs:annotation>
															<xs:documentation xml:lang="ro">perioadă nedeterminată</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="2">
														<xs:annotation>
															<xs:documentation xml:lang="ro">perioadă determinată</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="wheelchairDays" type="xs:integer" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Număr de zile recomandate pentru fotolii rulante</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="inferiorProthesis" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Opţiuni pentru protezele de membru inferior</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:integer">
													<xs:enumeration value="1">
														<xs:annotation>
															<xs:documentation xml:lang="ro">proteză provizorie</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="2">
														<xs:annotation>
															<xs:documentation xml:lang="ro">proteză definitivă</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="pairMedicalDevice" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Dispozitive medicale ce se pot acorda pereche</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:integer">
													<xs:enumeration value="1">
														<xs:annotation>
															<xs:documentation xml:lang="ro">stânga</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="2">
														<xs:annotation>
															<xs:documentation xml:lang="ro">dreapta</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
													<xs:enumeration value="3">
														<xs:annotation>
															<xs:documentation xml:lang="ro">ambele</xs:documentation>
														</xs:annotation>
													</xs:enumeration>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="deviceCode" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Cod dispozitiv medical (valoare din nomenclatorul de dispozitive medicale)</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="20"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="deviceType" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Tipul de dispozitiv medical (valoare din nomenclatorul de dispozitive medicale)</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="20"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="merNoSleep" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Numărul inregistrării atestatului în Managementul general, clinic şi terapeutic al tulburărilor respiratorii din timpul somnului – Somnologie</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="20"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="merDateSleep" type="xs:date" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Data inregistrării atestatului în Managementul general, clinic şi terapeutic al tulburărilor respiratorii din timpul somnului – Somnologie</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="merNoSleepTest" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Numărul înregistrării atestatului în Managementul general, clinic şi terapeutic al tulburărilor respiratorii din timpul somnului - Somnologie poligrafie, polisomnografie şi titrare CPAP/BPAP</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="20"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="merDateSleepTest" type="xs:date" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Data înregistrării atestatului în Managementul general, clinic şi terapeutic al tulburărilor respiratorii din timpul somnului - Somnologie poligrafie, polisomnografie şi titrare CPAP/BPAP</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="merNoOxygen" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Numărul înregistrării atestatului în Managementul general, clinic şi terapeutic al tulburărilor respiratorii - Ventilaţie non-invazivă</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="20"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="merDateOxygen" type="xs:date" use="optional">
											<xs:annotation>
												<xs:documentation xml:lang="ro">Data înregistrării atestatului în Managementul general, clinic şi terapeutic al tulburărilor respiratorii - Ventilaţie non-invazivă</xs:documentation>
											</xs:annotation>
										</xs:attribute>
									</xs:extension>
								</xs:complexContent>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
</xs:schema>

<?xml version="1.0" encoding="utf-8"?>
<xs:schema targetNamespace="http://www.cnas.ro/pias/2.0" xmlns="http://www.cnas.ro/pias/2.0" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" id="UnconsumeDocumentRequest">
    <xs:annotation>
        <xs:documentation xml:lang="ro">Structura unei cereri de revenire a unui document din starea CONSUMED în FINALIZED</xs:documentation>
    </xs:annotation>
    <xs:include schemaLocation="CommonDocumentTypesPias.xsd"/>
    <xs:element name="UnconsumeDocumentRequest">
        <xs:annotation>
            <xs:documentation xml:lang="ro">Cerere de tranziţie inversă (CONSUMED -&gt; FINALIZED) cu ştergerea informaţiilor de consumare</xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attribute name="personCID" use="required">
                <xs:annotation>
                    <xs:documentation xml:lang="ro">Codul de asigurat al pacientului/beneficiarului</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <!-- CNAS archive references undefined fpidType. Validate only the documented numeric CID branch. -->
                    <xs:union memberTypes="cidType"/>
                </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="serialCode" use="required">
                <xs:annotation>
                    <xs:documentation xml:lang="ro">Seria documentului medical</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:maxLength value="20"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="serialNo" use="required">
                <xs:annotation>
                    <xs:documentation xml:lang="ro">Numărul documentului medical</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:maxLength value="20"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="issueDate" type="xs:date" use="required">
                <xs:annotation>
                    <xs:documentation xml:lang="ro">Data emiterii documentului medical</xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="providerCode" use="required">
                <xs:annotation>
                    <xs:documentation xml:lang="ro">Codul fiscal al furnizorului care anulează consumul</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:maxLength value="20"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="providerInsuranceHouse" use="required">
                <xs:annotation>
                    <xs:documentation xml:lang="ro">Codul casei judeţene de asigurări asociate furnizorului</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:maxLength value="20"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
</xs:schema>
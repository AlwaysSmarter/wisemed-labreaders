<?xml version="1.0" encoding="utf-8"?>
<xs:schema targetNamespace="http://www.cnas.ro/pias/2.0" xmlns="http://www.cnas.ro/pias/2.0" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" id="GetDocumentStatusResponse">
    <xs:annotation>
        <xs:documentation xml:lang="ro">Structura unui răspuns pentru cererea de interogare a stării unui document medical</xs:documentation>
    </xs:annotation>
    <xs:include schemaLocation="CommonDocumentTypesPias.xsd"/>
    <xs:element name="GetDocumentStatusResponse">
        <xs:annotation>
            <xs:documentation xml:lang="ro">Răspuns pentru cererea de interogare a stării unui document medical</xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:complexContent>
                <xs:extension base="responseBaseType">
                    <xs:attribute name="status" use="optional">
                        <xs:annotation>
                            <xs:documentation xml:lang="ro">Starea curentă a documentului (prezent doar dacă documentul a fost găsit)</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                            <xs:restriction base="xs:string">
                                <xs:enumeration value="NEW"/>
                                <xs:enumeration value="MODIFIED"/>
                                <xs:enumeration value="FINALIZED"/>
                                <xs:enumeration value="CANCELED"/>
                                <xs:enumeration value="DELETED"/>
                                <xs:enumeration value="CONSUMED"/>
                                <xs:enumeration value="REPORTED"/>
                            </xs:restriction>
                        </xs:simpleType>
                    </xs:attribute>
                    <xs:attribute name="AppID" use="optional">
                        <xs:annotation>
                            <xs:documentation xml:lang="ro">Identificatorul unic al documentului la nivelul aplicaţiei de raportare</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                            <xs:restriction base="xs:string">
                                <xs:maxLength value="20"/>
                            </xs:restriction>
                        </xs:simpleType>
                    </xs:attribute>
                    <xs:attribute name="DocID" use="optional">
                        <xs:annotation>
                            <xs:documentation xml:lang="ro">Identificatorul unic al documentului la nivelul sistemului central</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                            <xs:restriction base="xs:string">
                                <xs:pattern value="[0-9A-Z]{25}"/>
                            </xs:restriction>
                        </xs:simpleType>
                    </xs:attribute>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:element>
</xs:schema>
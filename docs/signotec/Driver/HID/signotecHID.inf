; signotecHID.INF
; Installation inf for signotec HID Pads under Windows 8.1
; Copyright (c) 2014 signotec GmbH

[Version]
Signature	="$Windows NT$"
Class		=HIDClass

CLASSGUID	={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider	=%ProviderName%
CatalogFile	=signotecHID.cat
DriverVer	=01/07/2013,8.0.0.1

;[ControlFlags]
;ExcludeFromSelect=*

; ========== Manufacturer/Models sections ===========

[Manufacturer]
%ProviderName% = DeviceInstall,NTamd64

; Match on a hardware Vendor ID generated by the device

[DeviceInstall]
%DeviceDesc1%       = VendorDevice_Install, USB\VID_2133&PID_0001
%DeviceDesc2%       = VendorDevice_Install, USB\VID_2133&PID_000B


[DeviceInstall.NTamd64]
%DeviceDesc1%       = VendorDevice_Install, USB\VID_2133&PID_0001
%DeviceDesc2%       = VendorDevice_Install, USB\VID_2133&PID_000B


; =================== Installation ===================

[VendorDevice_Install.NT]
include     	= input.inf
needs       	= HID_Inst.NT
AddReg      	= VendorDevice_AddReg

[VendorDevice_Install.NT.HW]
Include		= INPUT.inf
Needs 		= HID_Inst.NT
AddReg 		= VendorDevice_AddReg

[VendorDevice_AddReg]
HKR,,"EnhancedPowerManagementEnabled",0x00010001,0
HKR,,"SelectiveSuspendEnabled",0x00010001,0
HKR,,"AllowIdleIrpInD3",0x00010001,1

[VendorDevice_Install.NT.Services]
include     = input.inf
needs       = HID_Inst.NT
AddService  = HidUsb,%SPSVCINST_ASSOCSERVICE%,HID_Service_Inst

; =================== Strings ===================
[Strings]
ProviderName     = "signotec"
DeviceDesc1="signotec LCD Signature Pad Sigma"
DeviceDesc2="signotec LCD Signature Pad Omega"
SPSVCINST_ASSOCSERVICE= 0x00000002
